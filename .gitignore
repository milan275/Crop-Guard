# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Model weights (large binary files — store with Git LFS or separately)
*.h5
*.keras

# Generated GeoTIFF outputs (regenerated on each pipeline run)
backend/data/geotiff/current_risk_map.tif
backend/data/geotiff/initial_pests.tif
backend/data/geotiff/ndvi.tif
backend/data/geotiff/temperature.tif
backend/data/geotiff/wind_speed.tif
backend/data/geotiff/forecasts/

# NDVI timeseries (large raster data — manage separately)
backend/data/geotiff/ndvi_timeseries/

# Fetched weather data
backend/data/weather/

# HTTP request cache
*.sqlite
*.db

# Node modules
node_modules/

# Environment variables
.env
.env.*
